# ── Claude (required for real board responses; mock used if absent) ──
# Local dev (.env.local): use ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=sk-ant-...
# Claude Code cloud environments reserve ANTHROPIC_API_KEY for the agent's own
# auth, so set this non-reserved name there instead (the app reads either):
# BOARDROOM_ANTHROPIC_API_KEY=sk-ant-...
# Model used for persona responses, synthesis, and live debates
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Supabase (optional; app falls back to localStorage if absent) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Phase 3+ integrations (stubbed; wire up later) ──
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
TAVUS_API_KEY=
STRIPE_SECRET_KEY=
